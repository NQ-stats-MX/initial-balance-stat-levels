//@version=6
indicator("Initial Balance Extension Stats", shorttitle = "IB Stats", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════
// CONSTANTS
// ════════════════════════════════════════════════════════════════════
const string TZ      = "America/New_York"
const string P_NYAM  = "NY AM (09:30-10:30)"
const string P_LUNCH = "NY Lunch (12:00-13:00)"
const string P_NYPM  = "NY PM (14:00-15:00)"
const string P_GLBX  = "Globex (18:00-19:00)"
const string P_TOKYO = "Tokyo (20:00-21:00)"
const string P_CUST  = "Custom"

const string G_SES  = "Initial Balance"
const string G_BOX  = "IB Box"
const string G_INT  = "IB Internal Levels (% from IB Low)"
const string G_STAT = "Extension Statistics"
const string G_LVL  = "Statistical Levels (Percentiles)"
const string G_LBL  = "Labels"
const string G_HIST = "History & Table"

// ════════════════════════════════════════════════════════════════════
// INPUTS — SESSION
// ════════════════════════════════════════════════════════════════════
string ibPreset     = input.string(P_NYAM, "IB Preset", options = [P_NYAM, P_LUNCH, P_NYPM, P_GLBX, P_TOKYO, P_CUST], group = G_SES)
string customSess   = input.session("0930-1030", "Custom IB Session (NY time)", group = G_SES)
bool   overrideExt  = input.bool(false, "Override Extension End", inline = "ext", group = G_SES)
string customExtEnd = input.string("1600", "HHMM", inline = "ext", group = G_SES, tooltip = "Extension window runs from IB close to this NY time (HHMM). Auto defaults: NY AM/Lunch/PM → 1600, Globex/Tokyo → 0300. Custom preset always uses this value.")

// ════════════════════════════════════════════════════════════════════
// INPUTS — BOX
// ════════════════════════════════════════════════════════════════════
color  boxBg      = input.color(color.new(#2962FF, 90), "Fill", inline = "b1", group = G_BOX)
color  boxBorder  = input.color(color.new(#2962FF, 40), "Border", inline = "b1", group = G_BOX)
string boxStyleIn = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], inline = "b2", group = G_BOX)
int    boxWidth   = input.int(1, "Width", minval = 0, maxval = 4, inline = "b2", group = G_BOX)
bool   extendLvls = input.bool(false, "Extend IB High/Low & Internal Levels Through Extension Window", group = G_BOX)
color  hlColor    = input.color(color.new(#2962FF, 30), "Extended High/Low", inline = "b3", group = G_BOX)
string hlStyleIn  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "b3", group = G_BOX)
int    hlWidth    = input.int(1, "", minval = 1, maxval = 4, inline = "b3", group = G_BOX)

// ════════════════════════════════════════════════════════════════════
// INPUTS — INTERNAL LEVELS (5 slots: on / % / color / style / width)
// ════════════════════════════════════════════════════════════════════
bool   i1On = input.bool(true,  "", inline = "i1", group = G_INT)
float  i1P  = input.float(50.0, "", minval = 0, maxval = 100, step = 0.5, inline = "i1", group = G_INT)
color  i1C  = input.color(color.new(#B2B5BE, 0), "", inline = "i1", group = G_INT)
string i1S  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "i1", group = G_INT)
int    i1W  = input.int(1, "", minval = 1, maxval = 4, inline = "i1", group = G_INT)

bool   i2On = input.bool(false, "", inline = "i2", group = G_INT)
float  i2P  = input.float(25.0, "", minval = 0, maxval = 100, step = 0.5, inline = "i2", group = G_INT)
color  i2C  = input.color(color.new(#B2B5BE, 30), "", inline = "i2", group = G_INT)
string i2S  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "i2", group = G_INT)
int    i2W  = input.int(1, "", minval = 1, maxval = 4, inline = "i2", group = G_INT)

bool   i3On = input.bool(false, "", inline = "i3", group = G_INT)
float  i3P  = input.float(75.0, "", minval = 0, maxval = 100, step = 0.5, inline = "i3", group = G_INT)
color  i3C  = input.color(color.new(#B2B5BE, 30), "", inline = "i3", group = G_INT)
string i3S  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "i3", group = G_INT)
int    i3W  = input.int(1, "", minval = 1, maxval = 4, inline = "i3", group = G_INT)

bool   i4On = input.bool(false, "", inline = "i4", group = G_INT)
float  i4P  = input.float(12.5, "", minval = 0, maxval = 100, step = 0.5, inline = "i4", group = G_INT)
color  i4C  = input.color(color.new(#B2B5BE, 50), "", inline = "i4", group = G_INT)
string i4S  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "i4", group = G_INT)
int    i4W  = input.int(1, "", minval = 1, maxval = 4, inline = "i4", group = G_INT)

bool   i5On = input.bool(false, "", inline = "i5", group = G_INT)
float  i5P  = input.float(87.5, "", minval = 0, maxval = 100, step = 0.5, inline = "i5", group = G_INT)
color  i5C  = input.color(color.new(#B2B5BE, 50), "", inline = "i5", group = G_INT)
string i5S  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "i5", group = G_INT)
int    i5W  = input.int(1, "", minval = 1, maxval = 4, inline = "i5", group = G_INT)

// ════════════════════════════════════════════════════════════════════
// INPUTS — STATISTICS
// ════════════════════════════════════════════════════════════════════
bool   showStats  = input.bool(true, "Show Statistical Levels", group = G_STAT)
bool   showUp     = input.bool(true, "Upside", inline = "sd", group = G_STAT)
bool   showDn     = input.bool(true, "Downside", inline = "sd", group = G_STAT)
string statsTfIn  = input.timeframe("30", "Stats Timeframe", options = ["1", "5", "15", "30", "60"], group = G_STAT, tooltip = "Samples are collected on this timeframe for much deeper history than the chart allows. Must divide the IB start/end and extension end evenly (30m works for all presets). If the chart timeframe is higher, the chart timeframe is used.")
string sampleMode = input.string("Break Days Only", "Sample", options = ["Break Days Only", "Dominant Side"], group = G_STAT, tooltip = "Break Days Only: upside stats come from days that broke the IB high, downside stats from days that broke the IB low (how far it runs, given the break).\nDominant Side: each day contributes its larger extension (up or down); one distribution mirrored on both sides.\nAll extensions are measured in IB multiples.")
int    lookback   = input.int(250, "Lookback (sessions)", minval = 5, maxval = 2000, group = G_STAT)
int    minSamples = input.int(10, "Min Samples Before Plotting", minval = 1, maxval = 500, group = G_STAT)

// Percentile slots (on / percentile / color / style / width)
bool   s1On = input.bool(true,  "", inline = "s1", group = G_LVL)
float  s1P  = input.float(25.0, "", minval = 1, maxval = 99, step = 1, inline = "s1", group = G_LVL)
color  s1C  = input.color(#9E9E9E, "", inline = "s1", group = G_LVL)
string s1S  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "s1", group = G_LVL)
int    s1W  = input.int(1, "", minval = 1, maxval = 4, inline = "s1", group = G_LVL)

bool   s2On = input.bool(true,  "", inline = "s2", group = G_LVL)
float  s2P  = input.float(50.0, "", minval = 1, maxval = 99, step = 1, inline = "s2", group = G_LVL)
color  s2C  = input.color(#FFB300, "", inline = "s2", group = G_LVL)
string s2S  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "s2", group = G_LVL)
int    s2W  = input.int(1, "", minval = 1, maxval = 4, inline = "s2", group = G_LVL)

bool   s3On = input.bool(true,  "", inline = "s3", group = G_LVL)
float  s3P  = input.float(75.0, "", minval = 1, maxval = 99, step = 1, inline = "s3", group = G_LVL)
color  s3C  = input.color(#FF7043, "", inline = "s3", group = G_LVL)
string s3S  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "s3", group = G_LVL)
int    s3W  = input.int(1, "", minval = 1, maxval = 4, inline = "s3", group = G_LVL)

bool   s4On = input.bool(true,  "", inline = "s4", group = G_LVL)
float  s4P  = input.float(90.0, "", minval = 1, maxval = 99, step = 1, inline = "s4", group = G_LVL)
color  s4C  = input.color(#E53935, "", inline = "s4", group = G_LVL)
string s4S  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "s4", group = G_LVL)
int    s4W  = input.int(1, "", minval = 1, maxval = 4, inline = "s4", group = G_LVL)

bool   s5On = input.bool(false, "", inline = "s5", group = G_LVL)
float  s5P  = input.float(95.0, "", minval = 1, maxval = 99, step = 1, inline = "s5", group = G_LVL)
color  s5C  = input.color(#8E24AA, "", inline = "s5", group = G_LVL)
string s5S  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "s5", group = G_LVL)
int    s5W  = input.int(2, "", minval = 1, maxval = 4, inline = "s5", group = G_LVL)

// ════════════════════════════════════════════════════════════════════
// INPUTS — LABELS / HISTORY / TABLE
// ════════════════════════════════════════════════════════════════════
bool   showStatLbl = input.bool(true,  "Statistical Level Labels", group = G_LBL)
bool   showIntLbl  = input.bool(false, "Internal Level Labels", group = G_LBL)
bool   showPrice   = input.bool(true,  "Include Price in Labels", group = G_LBL)
string lblSizeIn   = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal"], group = G_LBL)

bool   showHist  = input.bool(true, "Show Historical IBs & Levels", group = G_HIST)
int    histDays  = input.int(10, "Max Historical Sessions", minval = 1, maxval = 25, group = G_HIST, tooltip = "Capped at 25 to stay within TradingView's 500 line limit.")
bool   showTable = input.bool(true, "Show Stats Table", group = G_HIST)
string tblPosIn  = input.string("Top Right", "Table Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G_HIST)
string tblSizeIn = input.string("Small", "Table Text Size", options = ["Tiny", "Small", "Normal"], group = G_HIST)
color  tblBg     = input.color(color.new(#131722, 15), "Table BG", inline = "t1", group = G_HIST)
color  tblTxt    = input.color(#D1D4DC, "Text", inline = "t1", group = G_HIST)

// ════════════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════════════
lineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

toSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

fmtExt(float v) =>
    str.tostring(v, "#.##") + "x"

hhmmToMin(string s) =>
    int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))

pctOrNa(array<float> a, float p) =>
    a.size() > 0 ? a.percentile_linear_interpolation(p) : na

rateOrNa(array<int> a) =>
    a.size() > 0 ? a.avg() * 100 : na

// ════════════════════════════════════════════════════════════════════
// SESSION RESOLUTION
// ════════════════════════════════════════════════════════════════════
string ibSess = switch ibPreset
    P_NYAM  => "0930-1030"
    P_LUNCH => "1200-1300"
    P_NYPM  => "1400-1500"
    P_GLBX  => "1800-1900"
    P_TOKYO => "2000-2100"
    => customSess

string autoEnd = switch ibPreset
    P_GLBX  => "0300"
    P_TOKYO => "0300"
    P_CUST  => customExtEnd
    => "1600"

string ibStartStr = str.substring(ibSess, 0, 4)
string ibEndStr   = str.substring(ibSess, 5, 9)
string extEnd     = overrideExt ? customExtEnd : autoEnd
string extSess    = ibEndStr + "-" + extEnd

int  ibDurMin = (hhmmToMin(ibEndStr) - hhmmToMin(ibStartStr) + 1440) % 1440
bool tfOk     = timeframe.isintraday and timeframe.in_seconds() <= ibDurMin * 60

// Stats timeframe: never lower than the chart timeframe
string statsTf  = timeframe.in_seconds(statsTfIn) < timeframe.in_seconds() ? timeframe.period : statsTfIn
int    statsMin = timeframe.in_seconds(statsTf) / 60
bool   statsAligned = hhmmToMin(ibStartStr) % statsMin == 0 and hhmmToMin(ibEndStr) % statsMin == 0 and hhmmToMin(extEnd) % statsMin == 0

string lblSize = toSize(lblSizeIn)

// Slot config arrays
var array<bool>   intOn  = array.from(i1On, i2On, i3On, i4On, i5On)
var array<float>  intPct = array.from(i1P, i2P, i3P, i4P, i5P)
var array<color>  intCol = array.from(i1C, i2C, i3C, i4C, i5C)
var array<string> intSty = array.from(i1S, i2S, i3S, i4S, i5S)
var array<int>    intWid = array.from(i1W, i2W, i3W, i4W, i5W)

var array<bool>   stOn  = array.from(s1On, s2On, s3On, s4On, s5On)
var array<float>  stPct = array.from(s1P, s2P, s3P, s4P, s5P)
var array<color>  stCol = array.from(s1C, s2C, s3C, s4C, s5C)
var array<string> stSty = array.from(s1S, s2S, s3S, s4S, s5S)
var array<int>    stWid = array.from(s1W, s2W, s3W, s4W, s5W)

// ════════════════════════════════════════════════════════════════════
// SAMPLE COLLECTION — runs inside the stats-timeframe context
// Returns percentiles + counts, offset [1] so only completed stats-TF bars
// are used (non-repainting with lookahead_on).
// ════════════════════════════════════════════════════════════════════
calcStats() =>
    var array<float> upS = array.new<float>()
    var array<float> dnS = array.new<float>()
    var array<int>   bU  = array.new<int>()
    var array<int>   bD  = array.new<int>()
    var array<int>   bB  = array.new<int>()
    var bool  trk = false
    var bool  ext = false
    var float h   = na
    var float l   = na
    var float ph  = na
    var float pl  = na

    bool sIn  = not na(time(timeframe.period, ibSess, TZ))
    bool sExt = not na(time(timeframe.period, extSess, TZ))
    bool sSt  = sIn and not sIn[1]
    bool sEn  = not sIn and sIn[1]

    // Finalize previous extension window
    if ext and (sSt or not sExt)
        float rng = h - l
        if rng > 0
            bool  bu    = ph > h
            bool  bd    = pl < l
            float upRaw = math.max(ph - h, 0.0)
            float dnRaw = math.max(l - pl, 0.0)
            float upV   = upRaw / rng
            float dnV   = dnRaw / rng
            if sampleMode == "Dominant Side"
                float dom = math.max(upV, dnV)
                upS.push(dom)
                dnS.push(dom)
            else
                if bu
                    upS.push(upV)
                if bd
                    dnS.push(dnV)
            bU.push(bu ? 1 : 0)
            bD.push(bd ? 1 : 0)
            bB.push(bu and bd ? 1 : 0)
            while upS.size() > lookback
                upS.shift()
            while dnS.size() > lookback
                dnS.shift()
            while bU.size() > lookback
                bU.shift()
                bD.shift()
                bB.shift()
        ext := false

    // IB formation
    if sSt
        trk := true
        h   := high
        l   := low
    else if trk and sIn
        h := math.max(h, high)
        l := math.min(l, low)

    // IB close → extension tracking
    if sEn and trk
        trk := false
        ext := true
        ph  := high
        pl  := low
    else if ext and sExt
        ph := math.max(ph, high)
        pl := math.min(pl, low)

    float u1 = pctOrNa(upS, s1P)
    float u2 = pctOrNa(upS, s2P)
    float u3 = pctOrNa(upS, s3P)
    float u4 = pctOrNa(upS, s4P)
    float u5 = pctOrNa(upS, s5P)
    float d1 = pctOrNa(dnS, s1P)
    float d2 = pctOrNa(dnS, s2P)
    float d3 = pctOrNa(dnS, s3P)
    float d4 = pctOrNa(dnS, s4P)
    float d5 = pctOrNa(dnS, s5P)
    int   nU = upS.size()
    int   nD = dnS.size()
    float rU = rateOrNa(bU)
    float rD = rateOrNa(bD)
    float rB = rateOrNa(bB)
    [u1[1], u2[1], u3[1], u4[1], u5[1], d1[1], d2[1], d3[1], d4[1], d5[1], nU[1], nD[1], rU[1], rD[1], rB[1]]

[u1, u2, u3, u4, u5, d1, d2, d3, d4, d5, nUp, nDn, rUp, rDn, rBoth] = request.security(syminfo.tickerid, statsTf, calcStats(), lookahead = barmerge.lookahead_on)

array<float> upQ = array.from(u1, u2, u3, u4, u5)
array<float> dnQ = array.from(d1, d2, d3, d4, d5)
int nUpS = na(nUp) ? 0 : nUp
int nDnS = na(nDn) ? 0 : nDn

// ════════════════════════════════════════════════════════════════════
// TYPES
// ════════════════════════════════════════════════════════════════════
type IBDay
    box          bx
    line         hiLn
    line         loLn
    array<line>  intLines
    array<float> intPcts
    array<label> intLabels
    array<line>  statLines
    array<label> statLabels

method wipe(IBDay d) =>
    box.delete(d.bx)
    line.delete(d.hiLn)
    line.delete(d.loLn)
    for ln in d.intLines
        line.delete(ln)
    for lb in d.intLabels
        label.delete(lb)
    for ln in d.statLines
        line.delete(ln)
    for lb in d.statLabels
        label.delete(lb)

// ════════════════════════════════════════════════════════════════════
// CHART-TF STATE (drawing only)
// ════════════════════════════════════════════════════════════════════
var array<IBDay> days = array.new<IBDay>()
var IBDay cur        = na
var bool  tracking   = false
var bool  extActive  = false
var float ibH        = na
var float ibL        = na
var int   ibStartBar = na

bool inIB    = not na(time(timeframe.period, ibSess, TZ))
bool inExt   = not na(time(timeframe.period, extSess, TZ))
bool ibStart = inIB and not inIB[1]
bool ibEnded = not inIB and inIB[1]

// End of extension window → stop stretching drawings
if extActive and (ibStart or not inExt)
    extActive := false

// ════════════════════════════════════════════════════════════════════
// NEW IB STARTS
// ════════════════════════════════════════════════════════════════════
if ibStart
    if not showHist
        for d in days
            d.wipe()
        days.clear()

    IBDay d = IBDay.new(box.new(bar_index, high, bar_index, low, border_color = boxBorder, border_width = boxWidth, border_style = lineStyle(boxStyleIn), bgcolor = boxBg), na, na, array.new<line>(), array.new<float>(), array.new<label>(), array.new<line>(), array.new<label>())

    for i = 0 to 4
        if intOn.get(i)
            float p = intPct.get(i)
            float y = low + (high - low) * p / 100
            d.intLines.push(line.new(bar_index, y, bar_index, y, color = intCol.get(i), style = lineStyle(intSty.get(i)), width = intWid.get(i)))
            d.intPcts.push(p)
            if showIntLbl
                d.intLabels.push(label.new(bar_index, y, str.tostring(p) + "%", style = label.style_label_left, color = color.new(color.black, 100), textcolor = intCol.get(i), size = lblSize))

    days.push(d)
    while days.size() > histDays + 1
        days.shift().wipe()

    cur        := d
    tracking   := true
    ibH        := high
    ibL        := low
    ibStartBar := bar_index
else if tracking and inIB
    ibH := math.max(ibH, high)
    ibL := math.min(ibL, low)

// Update IB drawings while forming
if tracking and inIB
    cur.bx.set_top(ibH)
    cur.bx.set_bottom(ibL)
    cur.bx.set_right(bar_index)
    for [i, ln] in cur.intLines
        float y = ibL + (ibH - ibL) * cur.intPcts.get(i) / 100
        ln.set_y1(y)
        ln.set_y2(y)
        ln.set_x2(bar_index)
    for [i, lb] in cur.intLabels
        lb.set_xy(bar_index, ibL + (ibH - ibL) * cur.intPcts.get(i) / 100)

// ════════════════════════════════════════════════════════════════════
// IB CLOSES → project statistical levels (prior sessions only)
// ════════════════════════════════════════════════════════════════════
if ibEnded and tracking
    tracking  := false
    extActive := true
    float rng  = ibH - ibL

    if extendLvls
        cur.hiLn := line.new(ibStartBar, ibH, bar_index, ibH, color = hlColor, style = lineStyle(hlStyleIn), width = hlWidth)
        cur.loLn := line.new(ibStartBar, ibL, bar_index, ibL, color = hlColor, style = lineStyle(hlStyleIn), width = hlWidth)

    if showStats and rng > 0
        for i = 0 to 4
            if stOn.get(i)
                float  p  = stPct.get(i)
                color  c  = stCol.get(i)
                string pn = "P" + str.tostring(p)
                float  qu = upQ.get(i)
                float  qd = dnQ.get(i)
                if showUp and nUpS >= minSamples and not na(qu)
                    float y = ibH + qu * rng
                    cur.statLines.push(line.new(bar_index, y, bar_index, y, color = c, style = lineStyle(stSty.get(i)), width = stWid.get(i)))
                    if showStatLbl
                        string t = pn + " ▲ " + fmtExt(qu) + (showPrice ? "  " + str.tostring(y, format.mintick) : "")
                        cur.statLabels.push(label.new(bar_index, y, t, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = lblSize))
                if showDn and nDnS >= minSamples and not na(qd)
                    float y = ibL - qd * rng
                    cur.statLines.push(line.new(bar_index, y, bar_index, y, color = c, style = lineStyle(stSty.get(i)), width = stWid.get(i)))
                    if showStatLbl
                        string t = pn + " ▼ " + fmtExt(qd) + (showPrice ? "  " + str.tostring(y, format.mintick) : "")
                        cur.statLabels.push(label.new(bar_index, y, t, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = lblSize))

// Stretch drawings across the extension window
if extActive and not na(cur)
    for ln in cur.statLines
        ln.set_x2(bar_index)
    for lb in cur.statLabels
        lb.set_x(bar_index)
    if extendLvls
        cur.hiLn.set_x2(bar_index)
        cur.loLn.set_x2(bar_index)
        for ln in cur.intLines
            ln.set_x2(bar_index)
        for lb in cur.intLabels
            lb.set_x(bar_index)

// ════════════════════════════════════════════════════════════════════
// STATS TABLE
// ════════════════════════════════════════════════════════════════════
string tblPos = switch tblPosIn
    "Bottom Right" => position.bottom_right
    "Top Left"     => position.top_left
    "Bottom Left"  => position.bottom_left
    => position.top_right

var table tbl = table.new(tblPos, 3, 16, bgcolor = tblBg, border_width = 1, border_color = color.new(#787B86, 60))

if showTable and barstate.islast
    string ts = toSize(tblSizeIn)
    tbl.clear(0, 0, 2, 15)
    int r = 0
    tbl.cell(0, r, ibPreset, text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, "▲ Up",   text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, "▼ Down", text_color = tblTxt, text_size = ts)
    r += 1
    for i = 0 to 4
        if stOn.get(i)
            float qu = upQ.get(i)
            float qd = dnQ.get(i)
            tbl.cell(0, r, "P" + str.tostring(stPct.get(i)), text_color = stCol.get(i), text_size = ts, text_halign = text.align_left)
            tbl.cell(1, r, na(qu) ? "—" : fmtExt(qu), text_color = tblTxt, text_size = ts)
            tbl.cell(2, r, na(qd) ? "—" : fmtExt(qd), text_color = tblTxt, text_size = ts)
            r += 1
    tbl.cell(0, r, "Samples", text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, str.tostring(nUpS), text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, str.tostring(nDnS), text_color = tblTxt, text_size = ts)
    r += 1
    tbl.cell(0, r, "Break %", text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, na(rUp) ? "—" : str.tostring(rUp, "#.#") + "%", text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, na(rDn) ? "—" : str.tostring(rDn, "#.#") + "%", text_color = tblTxt, text_size = ts)
    r += 1
    tbl.cell(0, r, "Both Sides %", text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, na(rBoth) ? "—" : str.tostring(rBoth, "#.#") + "%", text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, "", text_color = tblTxt, text_size = ts)
    r += 1
    tbl.cell(0, r, "Last IB Range", text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, na(ibH) ? "—" : str.tostring(ibH - ibL, format.mintick), text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, "pts", text_color = tblTxt, text_size = ts)
    r += 1
    tbl.cell(0, r, "Stats TF", text_color = tblTxt, text_size = ts, text_halign = text.align_left)
    tbl.cell(1, r, statsTf + "m", text_color = tblTxt, text_size = ts)
    tbl.cell(2, r, "", text_color = tblTxt, text_size = ts)
    r += 1
    if not tfOk
        tbl.cell(0, r, "⚠ Chart TF > IB length", text_color = color.orange, text_size = ts, text_halign = text.align_left)
        tbl.cell(1, r, "", text_color = tblTxt, text_size = ts)
        tbl.cell(2, r, "", text_color = tblTxt, text_size = ts)
        r += 1
    if not statsAligned
        tbl.cell(0, r, "⚠ Stats TF misaligned w/ session", text_color = color.orange, text_size = ts, text_halign = text.align_left)
        tbl.cell(1, r, "", text_color = tblTxt, text_size = ts)
        tbl.cell(2, r, "", text_color = tblTxt, text_size = ts)
